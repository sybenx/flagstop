{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flagstop",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tool/serve.py",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "flagstop-sandbox",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tool/sandbox.py",
        "run",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "flagstop-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web"
      ],
      "port": 8790
    }
  ]
}
